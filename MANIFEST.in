include README.md
include LICENSE

# Keep the wheel/sdist lean — exclude legacy, archive, demos, planning, and test data.
prune matlab
prune archive
prune videos
prune specs
prune docs
prune tests
prune scripts
prune .specify
prune .github

# Claude-derived development docs — never ship in distributions (operator directive 2026-06-12)
prune .claude
prune .planning
exclude CLAUDE.md
exclude AGENTS.md
exclude .domi-pin

global-exclude *.mat *.asv .DS_Store
